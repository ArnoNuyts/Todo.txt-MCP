{
  "name": "@arnoarnoarno/todo.txt-mcp",
  "version": "3.5.0",
  "description": "Model Context Protocol server for managing a todo.txt file",
  "license": "MIT",
  "type": "module",
  "bin": {
    "todo.txt-mcp": "bin/todo.txt-mcp.js"
  },
  "files": [
    "bin/",
    "dist/",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArnoNuyts/Todo.txt-MCP.git"
  },
  "homepage": "https://github.com/ArnoNuyts/Todo.txt-MCP#readme",
  "bugs": {
    "url": "https://github.com/ArnoNuyts/Todo.txt-MCP/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "todo.txt",
    "todo",
    "tasks",
    "agent"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.2.1",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "dev": "node --watch server.ts",
    "start": "node server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench:actions": "node bench/actions.ts",
    "bench:agent": "node bench/agent-eval.ts",
    "bench:worst-case": "node bench/worst-case-file.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "knip": "6.44.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
