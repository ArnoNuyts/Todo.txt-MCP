{
  "name": "todo.txt-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Model Context Protocol server for managing a todo.txt file",
  "engines": {
    "node": ">=24.2.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node --watch server.ts",
    "start": "node server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.22.0",
    "cors": "2.8.5",
    "express": "5.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
