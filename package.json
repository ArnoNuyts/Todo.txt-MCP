{
  "name": "todo.txt-mcp",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Model Context Protocol server for managing a todo.txt file",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "node --watch server.ts",
    "start": "node server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
