# Copy to .env (or export these variables) and adjust as needed.
# Defaults are secure, but MCP_AUTH_TOKEN (or MCP_AUTH_TOKENS /
# MCP_AUTH_TOKEN_FILE) is required: the server refuses to start without it.

# --- HTTP server -----------------------------------------------------------
# Interface to bind to. Keep 127.0.0.1 for local use; use 0.0.0.0 only inside
# a container or behind a reverse proxy.
HOST=127.0.0.1
# Listen port (integer 0-65535).
PORT=3000

# --- HTTP security ---------------------------------------------------------
# Comma-separated hostnames accepted in the Host header (hostnames only, no
# ports). Missing or invalid Host headers are rejected with 403.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated origins allowed for browser clients. Enforced on POST /mcp;
# other methods and paths only omit CORS headers, never reflect an origin, and
# never emit Access-Control-Allow-Origin: *. Requests without an Origin header
# are unaffected. Leave empty to disable CORS headers entirely.
MCP_ALLOWED_ORIGINS=http://localhost:3000
# REQUIRED: the server refuses to start without a token. Set one of
# MCP_AUTH_TOKEN, MCP_AUTH_TOKENS, or MCP_AUTH_TOKEN_FILE.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
#
# Multiple active tokens for rotation (comma or whitespace separated). Clients
# using any listed token are accepted, so a token can be rolled without
# downtime. Precedence: MCP_AUTH_TOKEN_FILE > MCP_AUTH_TOKENS > MCP_AUTH_TOKEN.
# MCP_AUTH_TOKENS=token-one,token-two
#
# Read tokens from a file instead of the environment. The file may contain one
# token per line or a comma/whitespace separated list. Keep it mode 0600.
# MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_auth_tokens
#
# Environment/file tokens shorter than 32 characters are rejected at startup.
# Set to 1 only for local experiments.
# MCP_ALLOW_WEAK_TOKEN=0

# --- Public exposure abuse controls ---------------------------------------
# Express trust proxy. Leave false unless a trusted reverse proxy sits in front
# of the server; enabling it without one lets clients spoof X-Forwarded-For and
# bypass the per-client limits. Accepts false, true, a hop count (1..n),
# "loopback", or comma-separated IP/CIDR values.
TRUST_PROXY=false
# Requests per client key per minute. 0 disables the rate limiter.
MCP_RATE_LIMIT_PER_MIN=60
# Failed authentications before a key is temporarily banned, and the sliding
# window used to count them.
MCP_AUTH_FAIL_LIMIT=10
MCP_AUTH_FAIL_WINDOW_SEC=900
# Base ban duration in seconds. Repeat bans escalate up to one hour.
MCP_AUTH_BAN_SEC=900
# Maximum in-flight POST /mcp requests before returning 503. 0 disables.
MCP_MAX_CONCURRENCY=20
# Global authentication-failure breaker (all keys): failures per window before
# /mcp sheds traffic, and how long it stays open.
MCP_GLOBAL_AUTH_FAIL_LIMIT=100
MCP_GLOBAL_AUTH_FAIL_WINDOW_SEC=60
MCP_GLOBAL_AUTH_FAIL_BAN_SEC=60
# Maximum keys retained by the in-process rate limiters.
MCP_MAX_TRACKED_KEYS=10000
# Note: Node enforces the 15s request and 10s header timeouts on its
# connectionsCheckingInterval tick (default 30s), so slow clients are cut off at
# about 30s unless that interval is lowered.

# --- Observability ---------------------------------------------------------
# Structured JSON log level: debug, info, warn, error. Info/debug go to stdout,
# warn/error to stderr. Tokens, request bodies, and todo content are never logged.
MCP_LOG_LEVEL=info
# Prometheus metrics are served at GET /metrics and require the bearer token.
# /metrics bypasses the /mcp rate limiter, lockout, and global breaker, so it is
# an unthrottled token oracle: keep the server bound to loopback
# (HOST=127.0.0.1) or protect /metrics at the reverse proxy.

# --- Tool surface ----------------------------------------------------------
# Set to 1, true, or yes (case-insensitive) to register only list_todos.
# Any other value, including unknown strings, leaves write tools enabled.
# MCP_READ_ONLY=0

# --- Resource limits -------------------------------------------------------
# Maximum todo file size in bytes (default: 1048576 = 1 MiB). Oversized files
# are rejected before parsing.
# TODOTXT_MCP_MAX_FILE_BYTES=1048576
# Maximum total number of todos (default: 10000). The limit is applied after
# recurrence expansion, so a completion that appends a follow-up past the cap
# fails with LIMIT_EXCEEDED and saves nothing.
# TODOTXT_MCP_MAX_TODOS=10000

# --- todo.txt backend ------------------------------------------------------
# Backend: "local" (default) or "webdav".
TODOTXT_MCP_BACKEND=local
# Local backend: path to the todo.txt file. In the Compose setup this is
# /data/todo.txt because the writable data directory is mounted there.
TODOTXT_MCP_LOCAL_FILENAME=todo.txt

# WebDAV backend (used when TODOTXT_MCP_BACKEND=webdav)
# TODOTXT_MCP_WEBDAV_URL=https://dav.example.com
# TODOTXT_MCP_WEBDAV_USERNAME=user
# TODOTXT_MCP_WEBDAV_PASSWORD=pass

# --- LLM tool-profile evaluation (npm run bench:agent) ---------------------
# Any OpenAI-compatible /chat/completions endpoint works. The API key falls
# back to OPENAI_API_KEY. A model is required unless you run with --mock.
# AGENT_EVAL_API_KEY=
# AGENT_EVAL_BASE_URL=https://api.openai.com/v1
# AGENT_EVAL_MODEL=
# AGENT_EVAL_TEMPERATURE=0
